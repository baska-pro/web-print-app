# ============================================================================
# Web Print App / PrintBot WebApp
# Copy file ini menjadi .env, lalu ubah minimal WEBAPP_PASSWORD.
# Jangan commit file .env yang berisi password/token asli.
# ============================================================================

# --- File manager ------------------------------------------------------------
# Format: Label:C:\Folder;Label2:D:\Arsip
# Kosongkan jika ingin menambahkan root lewat tombol "+ Folder" di WebApp.
FILE_MANAGER_ROOTS=
ROOTS_BASE_DIR=./data/roots
DATA_DIR=./data

# --- Printer lokal -----------------------------------------------------------
# Kosong = gunakan default printer Windows.
DEFAULT_PRINTER=
PRINT_JOB_TIMEOUT_SEC=900
PRINT_RENDER_DPI=144
PRINT_MAX_RETRIES=1
PRINTER_MONITOR_SEC=15

# --- WebApp ------------------------------------------------------------------
WEBAPP_HOST=0.0.0.0
WEBAPP_PORT=8000
WEBAPP_USERNAME=admin
WEBAPP_PASSWORD=CHANGE_ME_WITH_A_STRONG_PASSWORD
# Kosong = dibuat otomatis dan disimpan di data/webapp_secret.key.
WEBAPP_SECRET_KEY=
WEBAPP_SECURE_COOKIE=0

# --- Session & login protection ---------------------------------------------
SESSION_MAX_AGE_SEC=604800
SESSION_IDLE_SEC=28800
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SEC=300

# --- Upload, download, pagination, search ------------------------------------
MAX_UPLOAD_MB=50
MAX_DOWNLOAD_MB=50
WEB_ITEMS_PER_PAGE=20
SEARCH_MAX_RESULTS=40
INDEX_REFRESH_SEC=300

# --- Print quota -------------------------------------------------------------
MAX_JOBS_PER_HOUR=30
MAX_COPIES_PER_DAY=200
MAX_COPIES_PER_JOB=50

# --- Database / backup / maintenance ----------------------------------------
BACKUP_RETENTION_DAYS=14
DB_MAINTENANCE_HOURS=24

# --- Windows Task Scheduler --------------------------------------------------
AUTO_START_TASK=1
TASK_NAME=PrintBot-WebApp

# --- HTTP API ---------------------------------------------------------------
# Kosong = token dibuat otomatis di data/api_token.key.
WEBAPP_API_TOKEN=
# Pilihan umum: read,print,admin
WEBAPP_API_SCOPES=read,print

# --- Optional Telegram notification -----------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# --- Self update -------------------------------------------------------------
# Repo publik ini dapat dipakai sebagai sumber update.
UPDATE_URL=https://raw.githubusercontent.com/baska-pro/web-print-app/main/webapp-PrintBot.py
UPDATE_TOKEN=
AUTO_UPDATE_APPLY=0
UPDATE_CHECK_HOURS=6

# --- Logging -----------------------------------------------------------------
LOG_LEVEL=INFO
